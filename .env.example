# SAMT v1.1.0 Local Development Environment Configuration
# Copy to `.env` for local runs. Do NOT commit real secrets or production credentials.

# PostgreSQL 16 (matches docker-compose.yml)
POSTGRES_USER=samt
POSTGRES_PASSWORD=samt_local_dev_password
POSTGRES_DB=samt_v1_1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://samt:samt_local_dev_password@localhost:5433/samt_v1_1

# HTTP API server
PORT=8080
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Local Development Authentication Tokens (replace in any shared environment)
# Viewer: read-only access to DMA balances, night-flow, incidents, audit
SAMT_VIEWER_TOKEN=samt-dev-viewer-token
# Dispatcher: read + incident assessment/transitions + allocation/savings
SAMT_DISPATCHER_TOKEN=samt-dev-dispatcher-token
# Device ingress tokens bound to specific gateway device_ids (JSON map: token -> deviceId)
SAMT_DEVICE_TOKENS_JSON={"samt-dev-device-yas-01":"GW-YAS-01","samt-dev-device-yas-02":"GW-YAS-02","samt-dev-device-nas-01":"GW-NAS-01"}

# Notification Outbox local receiver (optional; defaults to in-process recording receiver if unset)
NOTIFICATION_RECEIVER_URL=

# Frontend API URL (prototype/.env or Vite env)
VITE_API_BASE_URL=http://localhost:8080/v1
